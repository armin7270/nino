# ==============================================================================
# AnyTLS Manager Panel — environment variables
#
# Copy to `.env` for local runs, or paste into
# Railway → Service → Variables. Every value below is OPTIONAL: the panel has a
# working default for each one.
# ==============================================================================

# ------------------------------------------------------------------------------
# Web panel
# ------------------------------------------------------------------------------

# Port the web panel binds to. Railway injects PORT automatically — do NOT set
# this on Railway; it is only useful for local runs.
# PORT=3000

# Panel administrator credentials, used only when data/config.json does not exist
# yet (first boot, or after wiping the volume).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# Public AnyTLS endpoint (the VPN port)
# ------------------------------------------------------------------------------

# The single public port the panel listens on for VPN clients. This is the value
# to enter as the "application port" when creating the Railway TCP Proxy.
ANYTLS_GATEWAY_PORT=8443

# First port used for the per-configuration tunnel processes on 127.0.0.1.
# They are internal-only and never exposed directly.
ANYTLS_INTERNAL_PORT_BASE=20100

# anytls-go release used to fetch the tunnel binary on first boot.
ANYTLS_VERSION=v0.0.13

# Set to false to disable the automatic binary download (the panel then expects
# anytls-server at ANYTLS_SERVER_BIN, /usr/local/bin, ./bin, or ./vendor).
# ANYTLS_AUTO_DOWNLOAD=true

# Explicit binary path (highest priority when set).
# ANYTLS_SERVER_BIN=/usr/local/bin/anytls-server

# Override the download URL entirely (useful for air-gapped or mirrored setups).
# ANYTLS_DOWNLOAD_URL=https://github.com/anytls/anytls-go/releases/download/v0.0.13/anytls_0.0.13_linux_amd64.zip

# Tunnel log verbosity: panic | fatal | error | warn | info | debug | trace
ANYTLS_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Optional: manually pin the public endpoint
#
# Railway detects RAILWAY_TCP_PROXY_DOMAIN / RAILWAY_TCP_PROXY_PORT on its own.
# Set these only if you front the service with your own domain, or to override
# detection. They can also be changed later from the panel UI.
# ------------------------------------------------------------------------------
# PUBLIC_HOST=shuttle.proxy.rlwy.net
# PUBLIC_PORT=15140

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------

# Directory holding config.json. On Railway, mount a volume here to keep tunnels,
# traffic counters and the admin password across redeploys.
DATA_DIR=/data

# Where the auto-downloaded anytls-server binary is stored.
# VENDOR_DIR=/app/vendor